<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="600"
        x:Class="WriterGui.MainWindow"
        Icon="avares://3DWriterGui/icon.png"
        Title="3DWriter" Width="1180" Height="600">
    <Grid ColumnDefinitions="440,*" Margin="10">
        <Grid Grid.Column="0" Margin="0,0,10,0" RowDefinitions="*,Auto">
        <TabControl Grid.Row="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </TabControl.Styles>
            <TabItem Header="Text">
                <ScrollViewer>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Text" FontWeight="Bold"/>
                    <TextBox Name="TextInputBox" AcceptsReturn="True" Height="100" Text="Welcome to 3DWriter!" ToolTip.Tip="The text to plot. Press Enter for a new line - each line is drawn below the previous one."/>

                    <TextBlock Text="Font" FontWeight="Bold"/>
                    <ComboBox Name="FontBox" HorizontalAlignment="Stretch" ToolTip.Tip="Stroke font (.cmf file) used to render the text - each font has its own character set, see fonts folder."/>

                    <TextBlock Text="Scale" FontWeight="Bold"/>
                    <DockPanel ToolTip.Tip="Font size multiplier - multiplies the font's native glyph height to get the plotted character height in mm.">
                        <TextBlock Name="ScaleValueText" DockPanel.Dock="Right" Width="40" VerticalAlignment="Center"/>
                        <Slider Name="ScaleSlider" Minimum="0.05" Maximum="1.0" Value="0.2" SmallChange="0.01"/>
                    </DockPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shapes">
                <ScrollViewer>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Drag on empty preview to draw a box, drag/right-click/Delete any shape to move/rotate/remove it (whole unit if loaded from JSON), or drop/load a shapes JSON file. JSON shapes: Box/Rectangle, Line, Triangle, Star, Arrow, Polygon (see forms/shapes-demo.json)." TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                    <Button Name="LoadBoxesButton" Content="Load shapes (JSON)..." HorizontalAlignment="Stretch" Click="OnLoadBoxesClick" ToolTip.Tip="Load a shapes JSON file - adds its shapes alongside whatever's already on the canvas."/>
                    <Button Name="SaveBoxesButton" Content="Save shapes (JSON)..." HorizontalAlignment="Stretch" Click="OnSaveBoxesClick" ToolTip.Tip="Save every shape currently on the canvas to a JSON file."/>
                    <Button Name="ClearBoxesButton" Content="Clear shapes" HorizontalAlignment="Stretch" Click="OnClearBoxesClick" ToolTip.Tip="Remove every shape from the canvas (text and image are unaffected)."/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Name="UndoButton" Content="Undo" Width="103" Click="OnUndoClick" IsEnabled="False" ToolTip.Tip="Undo the last shape add/move/delete."/>
                        <Button Name="RedoButton" Content="Redo" Width="103" Click="OnRedoClick" IsEnabled="False" ToolTip.Tip="Redo the last undone change."/>
                    </StackPanel>

                    <TextBlock Text="Forms" FontWeight="Bold"/>
                    <TextBlock Text="Drag a form onto the preview to add it." TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                    <WrapPanel Name="FormsPanel"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Image">
                <ScrollViewer>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Rastered alongside the text/shapes into the same GCode job." TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                    <Button Name="LoadImageButton" Content="Load image..." HorizontalAlignment="Stretch" Click="OnLoadImageClick" ToolTip.Tip="Pick a raster image (png/jpg/bmp/gif) to rasterize into pen strokes alongside the text/shapes."/>
                    <Button Name="ClearImageButton" Content="Clear image" HorizontalAlignment="Stretch" Click="OnClearImageClick" IsEnabled="False" ToolTip.Tip="Remove the loaded image (text and shapes are unaffected)."/>
                    <TextBlock Name="ImageFileText" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ImageOffsetXBox" Minimum="-2000" Maximum="2000" Value="45" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Image position X (mm) - independent of the text offset"/>
                        <TextBlock Text="x" VerticalAlignment="Center"/>
                        <NumericUpDown Name="ImageOffsetYBox" Minimum="-2000" Maximum="2000" Value="45" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Image position Y (mm)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ImageWidthBox" Minimum="1" Maximum="2000" Value="100" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Output width (mm), height follows aspect ratio"/>
                        <TextBlock Text="width mm" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ImageResolutionBox" Minimum="0.1" Maximum="20" Value="0.5" Increment="0.1" FormatString="0.0" Width="135" ToolTip.Tip="mm per raster line - smaller = finer but slower"/>
                        <TextBlock Text="mm/pixel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ImageMaxStrokeBox" Minimum="0" Maximum="200" Value="20" Increment="5" FormatString="0" Width="135" ToolTip.Tip="0 = off. Cuts long filled-area strokes into chunks with a fresh pen-up/down, to avoid paper tearing on long unbroken strokes"/>
                        <TextBlock Text="max stroke mm (0=off)" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Mode" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Name="ImageModeBox" HorizontalAlignment="Stretch" SelectedIndex="0" ToolTip.Tip="Fill: rasters solid areas like a filled silhouette. Outline: only draws detected edges - fewer/shorter strokes, sketch-like, no filled areas.">
                        <ComboBoxItem Content="Fill (rastered)"/>
                        <ComboBoxItem Content="Outline (edge detection)"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ImageThresholdBox" Minimum="0" Maximum="255" Value="128" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Fill mode only: grayscale cutoff 0-255 - pixels darker than this are drawn, lighter ones are left blank."/>
                        <TextBlock Text="threshold (fill)" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Name="ImageDitherBox" Content="Dither (fill mode, better for photos)" ToolTip.Tip="Floyd-Steinberg error diffusion instead of a hard threshold cutoff - turns grayscale gradients into a halftone dot pattern, usually more recognizable for photos."/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ImageEdgeThresholdBox" Minimum="1" Maximum="1000" Value="100" Increment="10" FormatString="0" Width="135" ToolTip.Tip="Outline mode only: Sobel gradient magnitude cutoff (roughly 0-1020) - lower finds more (fainter) edges, higher only strong ones."/>
                        <TextBlock Text="edge threshold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Name="ImageInvertBox" Content="Invert (light pixels / non-edges)" ToolTip.Tip="Fill mode: draw light pixels instead of dark ones. Outline mode: draw non-edges instead of edges."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Setup">
                <ScrollViewer>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Bed size (mm)" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="BedWidthBox" Minimum="10" Maximum="2000" Value="200" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Printable bed width - the design is checked against this and flagged if it goes out of bounds."/>
                        <TextBlock Text="x" VerticalAlignment="Center"/>
                        <NumericUpDown Name="BedHeightBox" Minimum="10" Maximum="2000" Value="200" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Printable bed height, same bounds-checking as width."/>
                    </StackPanel>

                    <TextBlock Text="Text offset (mm)" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="OffsetXBox" Minimum="0" Maximum="2000" Value="45" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Where the text/shapes block starts on the bed, X axis - top-left corner of the design."/>
                        <TextBlock Text="x" VerticalAlignment="Center"/>
                        <NumericUpDown Name="OffsetYBox" Minimum="0" Maximum="2000" Value="45" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Same, Y axis."/>
                    </StackPanel>

                    <TextBlock Text="Tool offset (mm) - pen tip vs. nozzle" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ToolOffsetXBox" Minimum="-2000" Maximum="2000" Value="-10" Increment="0.5" FormatString="0.0" Width="135" ToolTip.Tip="X offset"/>
                        <TextBlock Text="X / Y" VerticalAlignment="Center"/>
                        <NumericUpDown Name="ToolOffsetYBox" Minimum="-2000" Maximum="2000" Value="10" Increment="0.5" FormatString="0.0" Width="135" ToolTip.Tip="Y offset"/>
                    </StackPanel>

                    <TextBlock Text="Pen height Z (mm)" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="PenUpBox" Minimum="0" Maximum="200" Value="12" Increment="0.5" FormatString="0.0" Width="135" ToolTip.Tip="Z height while the pen is lifted/traveling - should clear the paper without hitting anything."/>
                        <TextBlock Text="up/down" VerticalAlignment="Center"/>
                        <NumericUpDown Name="PenDownBox" Minimum="0" Maximum="200" Value="8" Increment="0.5" FormatString="0.0" Width="135" ToolTip.Tip="Z height while drawing - low enough for firm paper contact, not so low it digs in."/>
                    </StackPanel>
                    <TextBlock Text="Initial clearance after homing (mm)" FontWeight="Bold"/>
                    <NumericUpDown Name="InitialClearanceBox" Minimum="0" Maximum="200" Value="30" Increment="0.5" FormatString="0.0" Width="135" ToolTip.Tip="One-off extra-high Z lift right after homing, before the first real move - a safety margin in case the bed sits higher than expected."/>

                    <TextBlock Text="Speed (mm/s)" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="TravelSpeedBox" Minimum="1" Maximum="500" Value="100" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Pen-up travel speed"/>
                        <TextBlock Text="travel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="DrawSpeedBox" Minimum="1" Maximum="500" Value="40" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Pen-down drawing speed"/>
                        <TextBlock Text="draw" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="ZSpeedBox" Minimum="1" Maximum="500" Value="40" Increment="5" FormatString="0" Width="135" ToolTip.Tip="Pen up/down lift speed"/>
                        <TextBlock Text="Z lift" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Warmup scribble" FontWeight="Bold"/>
                    <TextBlock Text="Draws a small zigzag partway through the job, pen held down, so a ballpoint pen that's gone dry starts flowing again." TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                    <CheckBox Name="WarmupScribbleBox" Content="Enable" ToolTip.Tip="Turn the warmup scribble on for this render."/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="WarmupXBox" Minimum="0" Maximum="2000" Value="20" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Scribble position X - pick a spot nothing else in the job uses, e.g. a corner."/>
                        <TextBlock Text="x" VerticalAlignment="Center"/>
                        <NumericUpDown Name="WarmupYBox" Minimum="0" Maximum="2000" Value="10" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Scribble position Y."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="WarmupSizeBox" Minimum="2" Maximum="100" Value="10" Increment="1" FormatString="0" Width="135" ToolTip.Tip="Scribble square size (mm)"/>
                        <TextBlock Text="size mm" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Name="WarmupProgressBox" Minimum="0" Maximum="100" Value="60" Increment="5" FormatString="0" Width="135" ToolTip.Tip="How far through the job to splice it in"/>
                        <TextBlock Text="% through job" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
            <Button Name="RenderButton" Content="Render" HorizontalAlignment="Stretch" Click="OnRenderClick"/>
            <Button Name="SaveButton" Content="Save GCode..." HorizontalAlignment="Stretch" Click="OnSaveClick" IsEnabled="False"/>
            <TextBlock Name="StatusText" TextWrapping="Wrap" Foreground="Crimson"/>
        </StackPanel>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Name="ZoomValueText" DockPanel.Dock="Right" Width="50" VerticalAlignment="Center"/>
                <Slider Name="ZoomSlider" Minimum="0.25" Maximum="8" Value="1" SmallChange="0.1"/>
            </DockPanel>

            <Border Grid.Row="1" Name="PreviewBorder" BorderBrush="Gray" BorderThickness="1" Background="Gainsboro" DragDrop.AllowDrop="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl>
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding #ZoomSlider.Value}" ScaleY="{Binding #ZoomSlider.Value}"/>
                        </LayoutTransformControl.LayoutTransform>
                        <Canvas Name="PreviewCanvas" Background="White"/>
                    </LayoutTransformControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
