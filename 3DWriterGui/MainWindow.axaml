<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="600"
        x:Class="WriterGui.MainWindow"
        Title="3DWriter" Width="1060" Height="600">
    <Grid ColumnDefinitions="140,320,*" Margin="10">
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Forms" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Top" Text="Drag a form onto the preview to add it." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
            <ScrollViewer>
                <StackPanel Name="FormsPanel" Spacing="10"/>
            </ScrollViewer>
        </DockPanel>

        <ScrollViewer Grid.Column="1" Margin="0,0,10,0">
        <StackPanel Spacing="8">
            <TextBlock Text="Text" FontWeight="Bold"/>
            <TextBox Name="TextInputBox" AcceptsReturn="True" Height="100" Text="Welcome to 3DWriter!"/>

            <TextBlock Text="Font" FontWeight="Bold"/>
            <ComboBox Name="FontBox" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Scale" FontWeight="Bold"/>
            <DockPanel>
                <TextBlock Name="ScaleValueText" DockPanel.Dock="Right" Width="40" VerticalAlignment="Center"/>
                <Slider Name="ScaleSlider" Minimum="0.05" Maximum="1.0" Value="0.2" SmallChange="0.01"/>
            </DockPanel>

            <TextBlock Text="Bed size (mm)" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <NumericUpDown Name="BedWidthBox" Minimum="10" Maximum="2000" Value="200" Increment="5" FormatString="0" Width="135"/>
                <TextBlock Text="x" VerticalAlignment="Center"/>
                <NumericUpDown Name="BedHeightBox" Minimum="10" Maximum="2000" Value="200" Increment="5" FormatString="0" Width="135"/>
            </StackPanel>

            <TextBlock Text="Text offset (mm)" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <NumericUpDown Name="OffsetXBox" Minimum="0" Maximum="2000" Value="45" Increment="1" FormatString="0" Width="135"/>
                <TextBlock Text="x" VerticalAlignment="Center"/>
                <NumericUpDown Name="OffsetYBox" Minimum="0" Maximum="2000" Value="45" Increment="1" FormatString="0" Width="135"/>
            </StackPanel>

            <TextBlock Text="Tool offset (mm) - pen tip vs. nozzle" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <NumericUpDown Name="ToolOffsetXBox" Minimum="-2000" Maximum="2000" Value="-10" Increment="0.5" FormatString="0.0" Width="135"/>
                <TextBlock Text="x" VerticalAlignment="Center"/>
                <NumericUpDown Name="ToolOffsetYBox" Minimum="-2000" Maximum="2000" Value="10" Increment="0.5" FormatString="0.0" Width="135"/>
            </StackPanel>

            <TextBlock Text="Pen height Z (mm)" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <NumericUpDown Name="PenUpBox" Minimum="0" Maximum="200" Value="12" Increment="0.5" FormatString="0.0" Width="135"/>
                <TextBlock Text="up/down" VerticalAlignment="Center"/>
                <NumericUpDown Name="PenDownBox" Minimum="0" Maximum="200" Value="8" Increment="0.5" FormatString="0.0" Width="135"/>
            </StackPanel>
            <TextBlock Text="Initial clearance after homing (mm)" FontWeight="Bold"/>
            <NumericUpDown Name="InitialClearanceBox" Minimum="0" Maximum="200" Value="30" Increment="0.5" FormatString="0.0" Width="135"/>

            <TextBlock Text="Shapes" FontWeight="Bold"/>
            <TextBlock Text="Drag on empty preview to draw a box, drag/right-click/Delete any shape to move/rotate/remove it (whole unit if loaded from JSON), or drop/load a shapes JSON file. JSON shapes: Box/Rectangle, Line, Triangle, Star, Arrow, Polygon (see forms/shapes-demo.json)." TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
            <Button Name="LoadBoxesButton" Content="Load shapes (JSON)..." HorizontalAlignment="Stretch" Click="OnLoadBoxesClick"/>
            <Button Name="SaveBoxesButton" Content="Save shapes (JSON)..." HorizontalAlignment="Stretch" Click="OnSaveBoxesClick"/>
            <Button Name="ClearBoxesButton" Content="Clear shapes" HorizontalAlignment="Stretch" Click="OnClearBoxesClick"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="UndoButton" Content="Undo" Width="103" Click="OnUndoClick" IsEnabled="False"/>
                <Button Name="RedoButton" Content="Redo" Width="103" Click="OnRedoClick" IsEnabled="False"/>
            </StackPanel>

            <Button Name="RenderButton" Content="Render" HorizontalAlignment="Stretch" Click="OnRenderClick"/>
            <Button Name="SaveButton" Content="Save GCode..." HorizontalAlignment="Stretch" Click="OnSaveClick" IsEnabled="False"/>

            <TextBlock Name="StatusText" TextWrapping="Wrap" Foreground="Crimson"/>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Name="ZoomValueText" DockPanel.Dock="Right" Width="50" VerticalAlignment="Center"/>
                <Slider Name="ZoomSlider" Minimum="0.25" Maximum="8" Value="1" SmallChange="0.1"/>
            </DockPanel>

            <Border Grid.Row="1" Name="PreviewBorder" BorderBrush="Gray" BorderThickness="1" Background="Gainsboro" DragDrop.AllowDrop="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl>
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding #ZoomSlider.Value}" ScaleY="{Binding #ZoomSlider.Value}"/>
                        </LayoutTransformControl.LayoutTransform>
                        <Canvas Name="PreviewCanvas" Background="White"/>
                    </LayoutTransformControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
